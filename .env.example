# Postgres (Neon, vía Vercel Marketplace/Storage). Vercel la inyecta automáticamente
# al conectar el proyecto a una base de datos; en local, copia la cadena desde el
# dashboard de Vercel/Neon.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Vercel Blob (Storage → Blob en el dashboard de Vercel).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Secreto para firmar las cookies de sesión de /admin (jose/HS256).
# Generar uno nuevo, por ejemplo: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Correo al que se dirige el botón "Contactar" en entradas de la categoría
# "desaparecidos" (no se muestra el teléfono del reportante públicamente).
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL="contacto@unidosporcolombia.org"

# El número de WhatsApp al que se mandan los reportes públicos está
# hardcodeado en components/report-form.tsx (WHATSAPP_NUMBER) — el formulario
# público ya no guarda nada en la base de datos, así que ese número no es un
# secreto y no necesita vivir en variables de entorno.

# --- Primer admin ---
# No hay UI de registro. Sembrar el primer usuario admin corriendo, con
# DATABASE_URL ya configurada:
#   node scripts/seed-admin.mjs <usuario> <password>
